# Environment and credentials
.env
.env.*
!.env.example
**/secrets/
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer

# Runtime data
*.log
*.db
*.sqlite
*.sqlite-*
*.pid

# Editor and operating-system files
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.idea/
.vscode/

# Browser checks generate local screenshots and page snapshots.
.playwright-mcp/

